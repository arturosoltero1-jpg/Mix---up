{
  "name": "mix-up-ear-desktop",
  "productName": "Mix up-ear",
  "version": "1.0.0",
  "description": "Mix up-ear — automix con tocadiscos para Windows y Linux",
  "author": {
    "name": "Mix up-ear",
    "email": "noreply@example.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "node copy-www.js && electron .",
    "dist": "node copy-www.js && electron-builder --publish never",
    "dist:win": "node copy-www.js && electron-builder --win --publish never",
    "dist:linux": "node copy-www.js && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mixupear.desktop",
    "productName": "Mix up-ear",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "maintainer": "Mix up-ear <noreply@example.com>",
      "synopsis": "Automix con tocadiscos"
    },
    "artifactName": "Mix-up-ear-${version}-${os}.${ext}"
  },
  "homepage": "https://github.com/mix-up-ear/mix-up-ear"
}